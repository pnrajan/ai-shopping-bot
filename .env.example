# Copy to .env and fill in. Never commit .env. All keys are read from the environment only.

# ---- Mode ----
# fake: offline deterministic LLM and catalog (default; runs with no keys)
# live: real model provider below
SHOPBOT_LLM=fake
# fake | unwrangle
SHOPBOT_CATALOG=fake

# ---- Models (provider/model). Providers: openai, siliconflow, openrouter ----
# SHOPBOT_MODELS__UNDERSTANDING=openai/gpt-4o-mini
# SHOPBOT_MODELS__PLANNING=openai/gpt-4o-mini
# SHOPBOT_MODELS__RESPONSE=siliconflow/Qwen/Qwen3-8B
# SHOPBOT_MODELS__ENRICH=openrouter/anthropic/claude-haiku-5-5

# ---- Provider keys (set the ones your models use) ----
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
# OPENROUTER_API_KEY=

# ---- Catalog ----
# UNWRANGLE_APIKEY=

# ---- Server ----
SHOPBOT_HOST=127.0.0.1
SHOPBOT_PORT=8000
# Clients must send X-API-Key when set
# SHOPBOT_API_KEY=
SHOPBOT_RATE_LIMIT_PER_MINUTE=60

# ---- State ----
# memory | sqlite
SHOPBOT_SESSION_STORE=memory
SHOPBOT_SQLITE_PATH=shopbot.db
SHOPBOT_CACHE_TTL_S=86400
SHOPBOT_LLM_MAX_CALLS_PER_REQUEST=4

# ---- Tracking: price history and availability per product ----
# off | memory | sqlite
SHOPBOT_TRACKING=memory
# SHOPBOT_TRACKING_SQLITE_PATH=shopbot.db
# Re-check watched products every N seconds (0 = only on POST /watches/check)
SHOPBOT_TRACKING_MONITOR_INTERVAL_S=0

# ---- Observability (optional; pip install ".[otel]") ----
# SHOPBOT_OTEL_ENDPOINT=http://localhost:4318/v1/traces
