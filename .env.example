# Copy to .env and fill in. Never commit .env. All keys are read from the environment only.

# ---- Mode ----
# fake: offline deterministic LLM and catalog (default; runs with no keys)
# live: real model provider below
SHOPPER_LLM=fake
# fake | unwrangle
SHOPPER_CATALOG=fake

# ---- Models (provider/model). Providers: openai, siliconflow, openrouter ----
# SHOPPER_MODELS__UNDERSTANDING=openai/gpt-4o-mini
# SHOPPER_MODELS__PLANNING=openai/gpt-4o-mini
# SHOPPER_MODELS__RESPONSE=siliconflow/Qwen/Qwen3-8B
# SHOPPER_MODELS__ENRICH=openrouter/anthropic/claude-haiku-5-5

# ---- Provider keys (set the ones your models use) ----
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
# OPENROUTER_API_KEY=

# ---- Catalog ----
# UNWRANGLE_APIKEY=

# ---- Server ----
SHOPPER_HOST=127.0.0.1
SHOPPER_PORT=8000
# Clients must send X-API-Key when set
# SHOPPER_API_KEY=
SHOPPER_RATE_LIMIT_PER_MINUTE=60

# ---- State ----
# memory | sqlite
SHOPPER_SESSION_STORE=memory
SHOPPER_SQLITE_PATH=shopper.db
SHOPPER_CACHE_TTL_S=86400
SHOPPER_LLM_MAX_CALLS_PER_REQUEST=4

# ---- Observability (optional; pip install ".[otel]") ----
# SHOPPER_OTEL_ENDPOINT=http://localhost:4318/v1/traces
